# OpenRouter API Key for free primary AI story simplification
OPENROUTER_API_KEY=

# Optional: Dedicated OpenRouter API Key for paid fallback model (defaults to OPENROUTER_API_KEY if omitted)
OPENROUTER_PAID_API_KEY=

# Monthly spend guard cap in USD for paid model fallback (default: 5.00)
OPENROUTER_MONTHLY_SPEND_CAP_USD=5.00

# Optional: Override primary free model or fallback paid model
# OPENROUTER_FREE_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
